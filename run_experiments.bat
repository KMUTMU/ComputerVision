@echo off
REM ====================================================================
REM  여러 실험을 자동으로 순서대로 돌리는 배치 파일 (Windows 전용)
REM  사용법: Anaconda Prompt에서 (cv) 환경 켜고 ->  run_experiments.bat
REM ====================================================================

echo ####################################################
echo #  학습률(lr)을 바꿔가며 CIFAR-10 실험을 자동 실행   #
echo ####################################################

REM 아래 리스트의 값들을 하나씩 lr 에 넣어가며 train.py 를 실행합니다.
for %%L in (0.001 0.01 0.1 0.5) do (
    echo.
    echo ============================================
    echo   실험 실행: --lr %%L
    echo ============================================
    python train.py --lr %%L --epochs 5
)

echo.
echo ####################################################
echo #  모든 실험 완료! results.csv 를 확인하세요.        #
echo ####################################################
pause
